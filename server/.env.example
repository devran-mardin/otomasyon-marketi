# Otomasyon Marketi — Ödeme Backend'i — Ortam Değişkenleri Şablonu
# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerlerinizi girin.
# .env dosyası ASLA git'e eklenmez (.gitignore korur) — anahtarlarınızı
# hiçbir zaman kod içine yazmayın veya paylaşmayın.

# Paddle API Anahtarı (Secret Key) — SADECE bu backend'de kullanılır.
# Paddle Dashboard > Developer Tools > Authentication > "API keys" içinden alın.
# Sandbox (test) hesabı: https://sandbox-vendors.paddle.com
# Production (canlı) hesabı: https://vendors.paddle.com
PADDLE_API_KEY=pdl_sdbx_apikey_...

# Paddle Webhook (Notification) İmza Gizli Anahtarı.
# Paddle Dashboard > Developer Tools > Notifications > "+ New destination" ile
# bu backend'in /api/webhook adresini ekledikten sonra oradaki gizli anahtardır.
PADDLE_WEBHOOK_SECRET=...

# "sandbox" (test kartlarıyla ücretsiz deneme) veya "production" (gerçek para).
# Sandbox ve production için AYRI Paddle hesabı, AYRI API anahtarı ve AYRI
# webhook secret gerekir — birbirine karıştırmayın.
PADDLE_ENV=sandbox

# Frontend'in (otomasyonmarketi.net) barındığı adres.
CLIENT_URL=https://otomasyonmarketi.net

# Bu backend'e tarayıcıdan istek atmasına izin verilen origin'ler (virgülle ayrılmış, boşluksuz).
# Yerel geliştirme için canlı sitenizin yanına localhost adresinizi de ekleyebilirsiniz.
ALLOWED_ORIGINS=https://otomasyonmarketi.net,http://localhost:5500

# Sunucunun dinleyeceği port (Railway kendi PORT'unu otomatik enjekte eder, yerelde 3000 kullanın)
PORT=3000
